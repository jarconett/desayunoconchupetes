{
  "expo": {
    "name": "Desayuno con Chupetes",
    "slug": "desayunoconchupetes",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "desayunoconchupetes",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FBF7F2",
    "ios": {
      "bundleIdentifier": "com.desayunoconchupetes.app",
      "supportsTablet": true,
      "infoPlist": {
        "UIBackgroundModes": ["remote-notification"]
      }
    },
    "android": {
      "package": "com.desayunoconchupetes.app",
      "adaptiveIcon": {
        "backgroundColor": "#FFF9F2",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": ["POST_NOTIFICATIONS", "SCHEDULE_EXACT_ALARM"],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "name": "Desayuno con Chupetes · Asesoría de sueño",
      "themeColor": "#4A9DA8",
      "backgroundColor": "#FBF7F2"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FBF7F2",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 220
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/android-icon-monochrome.png",
          "color": "#4A9DA8"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": false
    },
    "extra": {
      "eas": {
        "projectId": ""
      }
    }
  }
}
